  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">TapLineTree – one stand-in rubber tree</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input AssignableType_1 trunk {"hint":"The trunk mesh component (surface math is used to lay the guide on the bark)."}'
    - '// @input SceneObject glow {"hint":"Glow shell SceneObject (faint proximity glow)."}'
    - '// @input SceneObject cutGuide {"hint":"Cut guide root (line + start mark + end mark). Shown on trunk pinch, faded on end-mark pinch."}'
