    - '// @input SceneObject startMark {"hint":"Start mark SceneObject (child of CutGuide)."}'
    - "// @input SceneObject endMark {\"hint\":\"End mark SceneObject (child of CutGuide). Pinch it to say 'done'.\"}"
    - '// @input AssignableType_2 tipNote {"hint":"Tip note UI on this trunk."}'
